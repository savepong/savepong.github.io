---
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  lang?: string;
  image?: string;
}

const {
  title,
  description = 'Pongsiri Pisutakarathada (savepong) — CTO & Co-founder of Code Passion, former President of the Thai Programmer Association. Engineering leader in Bangkok.',
  lang = 'en',
  image,
} = Astro.props;

const site = Astro.site ?? new URL('https://savepong.co');
const canonical = new URL(Astro.url.pathname, site).href;
const ogImage = image ? new URL(image, site).href : 'https://github.com/savepong.png';
---

<!DOCTYPE html>
<html lang={lang}>
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{title}</title>
    <meta name="description" content={description}>
    <link rel="canonical" href={canonical}>
    <meta property="og:type" content="website">
    <meta property="og:url" content={canonical}>
    <meta property="og:site_name" content="savepong">
    <meta property="og:title" content={title}>
    <meta property="og:description" content={description}>
    <meta property="og:image" content={ogImage}>
    {image && <meta property="og:image:width" content="1200">}
    {image && <meta property="og:image:height" content="630">}
    <meta name="twitter:card" content={image ? 'summary_large_image' : 'summary'}>
    <meta name="twitter:image" content={ogImage}>

    <!-- Mark JS early so reveal styles never hide content for no-JS visitors -->
    <script is:inline>document.documentElement.classList.add('js');</script>

    <!-- Fonts: Instrument Serif (display), Geist (body), Geist Mono, Thai companions -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Instrument+Serif:ital@0;1&family=Geist:wght@300..700&family=Geist+Mono:wght@400;500&family=IBM+Plex+Sans+Thai:wght@300;400;500;600&family=Noto+Serif+Thai:wght@400;500&display=swap" rel="stylesheet">

    <!-- Favicon -->
    <link rel="icon" type="image/x-icon" href="/favicon.ico">
    <link rel="icon" type="image/png" sizes="96x96" href="/favicon-96x96.png">
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png">
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png">

    <!-- Apple Touch Icons -->
    <link rel="apple-touch-icon" sizes="57x57" href="/apple-icon-57x57.png">
    <link rel="apple-touch-icon" sizes="60x60" href="/apple-icon-60x60.png">
    <link rel="apple-touch-icon" sizes="72x72" href="/apple-icon-72x72.png">
    <link rel="apple-touch-icon" sizes="76x76" href="/apple-icon-76x76.png">
    <link rel="apple-touch-icon" sizes="114x114" href="/apple-icon-114x114.png">
    <link rel="apple-touch-icon" sizes="120x120" href="/apple-icon-120x120.png">
    <link rel="apple-touch-icon" sizes="144x144" href="/apple-icon-144x144.png">
    <link rel="apple-touch-icon" sizes="152x152" href="/apple-icon-152x152.png">
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-icon-180x180.png">

    <!-- Web App Manifest & MS Tiles -->
    <link rel="manifest" href="/manifest.json">
    <meta name="msapplication-config" content="/browserconfig.xml">
    <meta name="msapplication-TileColor" content="#07080a">
    <meta name="msapplication-TileImage" content="/ms-icon-144x144.png">
    <meta name="theme-color" content="#07080a">
</head>
<body>
    <a href="#main" class="skip-link">Skip to content</a>
    <div class="grain" aria-hidden="true"></div>
    <div class="progress no-print" id="progress" aria-hidden="true"></div>

    <slot />

    <script>
        // Scroll reveals: [data-reveal] fades up, [data-split] reveals line by line.
        const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        const targets = document.querySelectorAll<HTMLElement>('[data-reveal], [data-split]');

        if (reduce || !('IntersectionObserver' in window)) {
            targets.forEach((el) => el.classList.add('is-in'));
        } else {
            const io = new IntersectionObserver(
                (entries) => {
                    entries.forEach((entry) => {
                        if (entry.isIntersecting) {
                            entry.target.classList.add('is-in');
                            io.unobserve(entry.target);
                        }
                    });
                },
                { threshold: 0.15, rootMargin: '0px 0px -8% 0px' }
            );
            targets.forEach((el) => io.observe(el));
        }

        // Scroll progress hairline
        const progress = document.getElementById('progress');
        let progressQueued = false;
        const paintProgress = () => {
            progressQueued = false;
            const max = document.documentElement.scrollHeight - window.innerHeight;
            progress?.style.setProperty('--p', String(max > 0 ? window.scrollY / max : 0));
        };
        window.addEventListener('scroll', () => {
            if (!progressQueued) { progressQueued = true; requestAnimationFrame(paintProgress); }
        }, { passive: true });
        paintProgress();

        // Expand every <details> before printing so the CV prints in full.
        window.addEventListener('beforeprint', () => {
            document.querySelectorAll('details').forEach((d) => d.setAttribute('open', ''));
        });
    </script>
</body>
</html>
