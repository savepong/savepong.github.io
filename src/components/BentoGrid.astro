---
// "Now" — what I'm doing today, plus a few numbers.
import { getCollection } from 'astro:content';

const posts = await getCollection('blog');
const yearsShipping = new Date().getFullYear() - 2012;

const now = [
    {
        n: '01',
        org: 'Code Passion',
        role: 'CTO & Co-founder',
        since: 'Since 2020',
        body: 'Setting the roadmap and engineering standards. Agent Skills, spec-driven delivery and shared CI/CD let a small team ship regulated and LINE-based systems.',
    },
    {
        n: '02',
        org: 'Thai Programmer Association',
        role: 'Committee Member',
        since: 'President, Oct 2023 – Mar 2026',
        body: 'Served as President of a 200,000+ member community: an MOU with Alibaba Cloud, National Coding Day, and work alongside depa and NIA.',
    },
    {
        n: '03',
        org: 'Public service',
        role: 'Advisory & working groups',
        since: 'Ongoing',
        body: 'Subcommittee overseeing depa (strategy & digital economy promotion), Cyber Scout Thailand steering committee, Phra Nakhon District working group (BMA), and the Thai Website Standards working group (Digital Council of Thailand).',
    },
];

const stats = [
    { v: '200k+', k: 'developers in the TPA community' },
    { v: '20', k: 'engineers led at LSEG' },
    { v: `${yearsShipping}+`, k: 'years shipping software' },
    { v: String(posts.length), k: 'essays & notes on the blog' },
];
---

<section id="now" class="section">
    <div class="wrap">
        <div class="section-head">
            <p class="eyebrow" data-reveal>Right now</p>
            <h2 class="display h2" data-split>
                <span class="line"><span>Building teams,</span></span>
                <span class="line"><span style="--d:.1s">products &amp; <em>community.</em></span></span>
            </h2>
        </div>

        <ol class="now-list">
            {now.map((item, i) => (
                <li class="now-item" data-reveal style={`--d:${i * 0.08}s`}>
                    <span class="now-n mono">{item.n}</span>
                    <div class="now-main">
                        <h3 class="now-org">{item.org}</h3>
                        <p class="now-role">{item.role} <span class="mono now-since">{item.since}</span></p>
                    </div>
                    <p class="now-body">{item.body}</p>
                </li>
            ))}
        </ol>

        <dl class="stats">
            {stats.map((s, i) => (
                <div class="stat" data-reveal style={`--d:${i * 0.08}s`}>
                    <dt class="stat-k">{s.k}</dt>
                    <dd class="stat-v display">{s.v}</dd>
                </div>
            ))}
        </dl>
    </div>
</section>

<style>
    .now-list { list-style: none; margin: 0; padding: 0; }
    .now-item {
        display: grid;
        grid-template-columns: 48px 1fr;
        gap: 12px 24px;
        padding: 36px 0;
        border-top: 1px solid var(--line);
        transition: background 0.5s var(--ease);
    }
    .now-item:last-child { border-bottom: 1px solid var(--line); }
    .now-n { color: var(--coral); padding-top: 10px; }
    .now-org {
        font-family: var(--font-display);
        font-weight: 400;
        font-size: clamp(32px, 3.6vw, 52px);
        line-height: 1.05;
        letter-spacing: -0.02em;
        margin: 0 0 10px;
    }
    .now-role { margin: 0; color: var(--ink-2); display: flex; flex-wrap: wrap; gap: 8px 16px; align-items: baseline; }
    .now-since { color: var(--muted); }
    .now-body { grid-column: 2; margin: 0; color: var(--ink-2); max-width: 56ch; }

    @media (min-width: 900px) {
        .now-item { grid-template-columns: 80px 1.1fr 1fr; align-items: start; }
        .now-body { grid-column: 3; padding-top: 10px; }
    }

    .stats {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 0;
        margin: clamp(64px, 8vw, 120px) 0 0;
    }
    @media (min-width: 900px) { .stats { grid-template-columns: repeat(4, 1fr); } }
    .stat {
        display: flex;
        flex-direction: column-reverse;
        gap: 12px;
        padding: 24px 20px 24px 0;
        border-left: 1px solid var(--line);
        padding-left: 20px;
    }
    .stat-v {
        margin: 0;
        font-size: clamp(56px, 7vw, 104px);
        line-height: 0.9;
        background: linear-gradient(180deg, var(--ink) 30%, rgba(242, 239, 233, 0.35));
        -webkit-background-clip: text;
        background-clip: text;
        color: transparent;
    }
    .stat-k { color: var(--muted); font-size: 14px; max-width: 18ch; }
</style>
