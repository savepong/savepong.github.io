---
// Education & credentials — compact two-column index.
const academics = [
    { title: 'M.B.A., Strategic Management', detail: 'Rattana Bundit University', meta: '2018 – 2020' },
    { title: 'B.B.A., Information Systems', detail: 'Rajamangala University of Technology Tawan-ok · First-Class Honors', meta: '2013 – 2014' },
];

const certifications = [
    { title: 'WCAG 2.2 for Web Developers', detail: 'Udemy', meta: 'Dec 2024' },
    { title: 'Azure Fundamentals', detail: 'Microsoft', meta: '2023' },
    { title: 'Dev Environment in AWS with Terraform', detail: 'LinkedIn Learning', meta: 'Jan 2022' },
    { title: 'Certified SAFe® 5 Agilist', detail: 'Scaled Agile, Inc.', meta: 'Dec 2021' },
];

const speaking = [
    { title: 'Microsoft Build & Google I/O', detail: 'Speaker', meta: '' },
    { title: 'Thailand Developer Trends 2023', detail: 'GitHub Universe After Party, Bangkok', meta: '2023' },
    { title: 'Building the Digital Future', detail: 'Next-gen software development & cyber security, Gosoft', meta: '' },
    { title: 'Career talks', detail: 'Digital Skill Live, BUSIT, LearnCloud', meta: '' },
];

const groups = [
    { label: 'Academic', items: academics },
    { label: 'Certifications', items: certifications },
    { label: 'Speaking', items: speaking },
];
---

<section id="education" class="section">
    <div class="wrap">
        <div class="section-head">
            <p class="eyebrow" data-reveal>Credentials &amp; talks</p>
            <h2 class="display h2" data-split>
                <span class="line"><span>Learning in <em>public.</em></span></span>
            </h2>
        </div>

        <div class="cred-grid">
            {groups.map((g, gi) => (
                <div data-reveal style={`--d:${gi * 0.1}s`}>
                    <h3 class="cred-label mono">{g.label}</h3>
                    <ul class="cred-list">
                        {g.items.map((item) => (
                            <li class="cred">
                                <span class="cred-title">{item.title}</span>
                                <span class="cred-detail">{item.detail}</span>
                                <span class="cred-meta mono">{item.meta}</span>
                            </li>
                        ))}
                    </ul>
                </div>
            ))}
        </div>
    </div>
</section>

<style>
    .cred-grid { display: grid; grid-template-columns: 1fr; gap: 56px; }
    @media (min-width: 760px) { .cred-grid { grid-template-columns: 1fr 1fr; gap: 48px; } }
    @media (min-width: 1100px) { .cred-grid { grid-template-columns: repeat(3, 1fr); gap: 40px; } }
    .cred-label { color: var(--muted); text-transform: uppercase; letter-spacing: 0.08em; font-weight: 400; margin: 0 0 16px; }
    .cred-list { list-style: none; margin: 0; padding: 0; }
    .cred {
        display: grid;
        grid-template-columns: 1fr auto;
        grid-template-areas: 'title meta' 'detail meta';
        gap: 4px 16px;
        padding: 20px 0;
        border-top: 1px solid var(--line);
    }
    .cred:last-child { border-bottom: 1px solid var(--line); }
    .cred-title { grid-area: title; font-size: 17px; line-height: 1.4; }
    .cred-detail { grid-area: detail; color: var(--muted); font-size: 14px; }
    .cred-meta { grid-area: meta; align-self: start; padding-top: 3px; color: var(--ink-2); text-align: right; white-space: nowrap; }
</style>
