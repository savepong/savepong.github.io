---
// Hero — real HTML headline over a WebGL scene (noise-displaced iridescent
// orb inside a tilted particle ring). Three.js loads from a pinned CDN build,
// so package-lock.json is untouched. A CSS orb shows when WebGL is missing,
// the CDN fails, or the visitor prefers reduced motion (static frame).
---

<section id="hero" class="hero" aria-label="Introduction">
    <div class="hero-fallback" aria-hidden="true"></div>
    <canvas class="hero-canvas" id="hero-canvas" aria-hidden="true"></canvas>
    <div class="hero-vignette" aria-hidden="true"></div>

    <div class="wrap hero-content">
        <p class="eyebrow hero-eyebrow" data-reveal style="--d:.15s">
            Pongsiri Pisutakarathada — Bangkok, TH
        </p>

        <h1 class="display hero-title" data-split>
            <span class="line"><span style="--d:.2s">Pongsiri</span></span>
            <span class="line"><span style="--d:.32s"><em>Pisut.</em></span></span>
        </h1>

        <div class="hero-bottom">
            <p class="lede" data-reveal style="--d:.6s">
                CTO &amp; Co-founder of Code Passion. I lead engineers, build AI-native
                products, and help shape how Thailand writes software.
            </p>

            <div class="hero-cta" data-reveal style="--d:.75s">
                <a href="#ask" class="btn btn--solid">
                    <svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M12 2l2.5 7.5L22 12l-7.5 2.5L12 22l-2.5-7.5L2 12l7.5-2.5L12 2z" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"/></svg>
                    Ask my AI
                </a>
                <a href="#contact" class="btn">Get in touch</a>
            </div>
        </div>
    </div>

    <div class="wrap hero-meta mono" data-reveal style="--d:.9s">
        <div><span class="meta-k">Currently</span><span>CTO, Code Passion</span></div>
        <div class="hide-sm"><span class="meta-k">Community</span><span>Thai Programmer Association</span></div>
        <div class="hero-scroll"><span class="meta-k">Scroll</span><span class="scroll-line" aria-hidden="true"></span></div>
    </div>
</section>

<style>
    .hero {
        position: relative;
        min-height: 100svh;
        display: flex;
        flex-direction: column;
        justify-content: flex-end;
        padding: 120px 0 32px;
        overflow: hidden;
        isolation: isolate;
    }
    .hero-canvas {
        position: absolute;
        inset: 0;
        width: 100%;
        height: 100%;
        z-index: -2;
        opacity: 0;
        transition: opacity 1.6s var(--ease);
    }
    .hero.gl-ready .hero-canvas { opacity: 1; }
    .hero.gl-ready .hero-fallback { opacity: 0; }

    /* Fallback orb — also the first paint while Three.js loads */
    .hero-fallback {
        position: absolute;
        z-index: -3;
        width: min(62vw, 720px);
        aspect-ratio: 1;
        right: -6vw;
        top: 50%;
        transform: translateY(-55%);
        border-radius: 50%;
        background:
            radial-gradient(circle at 30% 30%, rgba(255, 154, 107, 0.55), transparent 45%),
            radial-gradient(circle at 70% 70%, rgba(46, 196, 182, 0.45), transparent 50%),
            radial-gradient(circle at 50% 50%, #15171c 0%, #07080a 70%);
        box-shadow: inset 0 0 120px rgba(0, 0, 0, 0.8), 0 0 160px rgba(255, 107, 74, 0.12);
        filter: blur(0.5px);
        transition: opacity 1.2s var(--ease);
    }
    .hero-vignette {
        position: absolute;
        inset: 0;
        z-index: -1;
        pointer-events: none;
        background:
            linear-gradient(to top, var(--bg) 0%, transparent 35%),
            radial-gradient(ellipse at 20% 80%, rgba(7, 8, 10, 0.85), transparent 60%);
    }

    .hero-content { position: relative; }
    .hero-eyebrow { margin-bottom: 28px; }
    .hero-title {
        font-size: clamp(76px, 15.5vw, 236px);
        line-height: 0.86;
        letter-spacing: -0.035em;
        margin-left: -0.04em;
    }
    .hero-bottom {
        display: flex;
        flex-wrap: wrap;
        align-items: flex-end;
        justify-content: space-between;
        gap: 32px;
        margin-top: clamp(28px, 4vw, 48px);
    }
    .hero-cta { display: flex; flex-wrap: wrap; gap: 12px; }

    .hero-meta {
        display: flex;
        gap: clamp(20px, 5vw, 72px);
        margin-top: clamp(48px, 8vh, 96px);
        padding-top: 20px;
        border-top: 1px solid var(--line);
        color: var(--ink-2);
    }
    .hero-meta > div { display: flex; flex-direction: column; gap: 6px; }
    .meta-k { color: var(--muted); text-transform: uppercase; letter-spacing: 0.08em; font-size: 11px; }
    .hero-scroll { margin-left: auto; align-items: flex-end; }
    .scroll-line {
        display: block;
        width: 1px;
        height: 28px;
        background: var(--line-2);
        position: relative;
        overflow: hidden;
    }
    .scroll-line::after {
        content: '';
        position: absolute;
        left: 0;
        top: -100%;
        width: 1px;
        height: 100%;
        background: var(--coral);
        animation: scrollcue 2s var(--ease) infinite;
    }
    @keyframes scrollcue { to { top: 100%; } }

    @media (max-width: 760px) {
        .hero-fallback { width: 86vw; right: 7vw; top: 26%; opacity: 0.8; }
        .hero-vignette {
            background:
                linear-gradient(to top, var(--bg) 0%, rgba(7, 8, 10, 0.86) 42%, transparent 70%);
        }
        .hero-bottom { gap: 24px; }
    }
    @media (max-width: 640px) {
        .hide-sm,
        .hero-meta > .hero-scroll { display: none; }
        .hero-meta { justify-content: space-between; }
    }
</style>

<script is:inline type="module">
    const hero = document.getElementById('hero');
    const canvas = document.getElementById('hero-canvas');
    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    const NOISE = /* glsl */ `
        vec3 mod289(vec3 x){return x-floor(x*(1.0/289.0))*289.0;}
        vec4 mod289(vec4 x){return x-floor(x*(1.0/289.0))*289.0;}
        vec4 permute(vec4 x){return mod289(((x*34.0)+1.0)*x);}
        vec4 taylorInvSqrt(vec4 r){return 1.79284291400159-0.85373472095314*r;}
        float snoise(vec3 v){
            const vec2 C=vec2(1.0/6.0,1.0/3.0);
            const vec4 D=vec4(0.0,0.5,1.0,2.0);
            vec3 i=floor(v+dot(v,C.yyy));
            vec3 x0=v-i+dot(i,C.xxx);
            vec3 g=step(x0.yzx,x0.xyz);
            vec3 l=1.0-g;
            vec3 i1=min(g.xyz,l.zxy);
            vec3 i2=max(g.xyz,l.zxy);
            vec3 x1=x0-i1+C.xxx;
            vec3 x2=x0-i2+C.yyy;
            vec3 x3=x0-D.yyy;
            i=mod289(i);
            vec4 p=permute(permute(permute(
                i.z+vec4(0.0,i1.z,i2.z,1.0))
                +i.y+vec4(0.0,i1.y,i2.y,1.0))
                +i.x+vec4(0.0,i1.x,i2.x,1.0));
            float n_=0.142857142857;
            vec3 ns=n_*D.wyz-D.xzx;
            vec4 j=p-49.0*floor(p*ns.z*ns.z);
            vec4 x_=floor(j*ns.z);
            vec4 y_=floor(j-7.0*x_);
            vec4 x=x_*ns.x+ns.yyyy;
            vec4 y=y_*ns.x+ns.yyyy;
            vec4 h=1.0-abs(x)-abs(y);
            vec4 b0=vec4(x.xy,y.xy);
            vec4 b1=vec4(x.zw,y.zw);
            vec4 s0=floor(b0)*2.0+1.0;
            vec4 s1=floor(b1)*2.0+1.0;
            vec4 sh=-step(h,vec4(0.0));
            vec4 a0=b0.xzyw+s0.xzyw*sh.xxyy;
            vec4 a1=b1.xzyw+s1.xzyw*sh.zzww;
            vec3 p0=vec3(a0.xy,h.x);
            vec3 p1=vec3(a0.zw,h.y);
            vec3 p2=vec3(a1.xy,h.z);
            vec3 p3=vec3(a1.zw,h.w);
            vec4 norm=taylorInvSqrt(vec4(dot(p0,p0),dot(p1,p1),dot(p2,p2),dot(p3,p3)));
            p0*=norm.x;p1*=norm.y;p2*=norm.z;p3*=norm.w;
            vec4 m=max(0.6-vec4(dot(x0,x0),dot(x1,x1),dot(x2,x2),dot(x3,x3)),0.0);
            m=m*m;
            return 42.0*dot(m*m,vec4(dot(p0,x0),dot(p1,x1),dot(p2,x2),dot(p3,x3)));
        }
    `;

    const ORB_VERT = /* glsl */ `
        uniform float uTime;
        uniform float uAmp;
        uniform float uFreq;
        varying vec3 vNormal;
        varying vec3 vViewPos;
        varying float vNoise;
        ${NOISE}
        float disp(vec3 p){
            float n=snoise(p*uFreq+vec3(uTime*0.16,uTime*0.11,-uTime*0.07));
            float n2=snoise(p*uFreq*2.4-vec3(uTime*0.09))*0.32;
            return (n+n2)*uAmp;
        }
        void main(){
            vec3 n=normalize(normal);
            vec3 t=normalize(cross(n, abs(n.y)<0.99 ? vec3(0.0,1.0,0.0) : vec3(1.0,0.0,0.0)));
            vec3 b=cross(n,t);
            float e=0.012;
            float d0=disp(position);
            vec3 p0=position+n*d0;
            vec3 q1=position+t*e; vec3 p1=q1+normalize(q1)*disp(q1);
            vec3 q2=position+b*e; vec3 p2=q2+normalize(q2)*disp(q2);
            vec3 dn=normalize(cross(p1-p0,p2-p0));
            if(dot(dn,n)<0.0) dn=-dn;
            vNoise=d0/max(uAmp,0.0001);
            vec4 mv=modelViewMatrix*vec4(p0,1.0);
            vViewPos=mv.xyz;
            vNormal=normalize(normalMatrix*dn);
            gl_Position=projectionMatrix*mv;
        }
    `;

    const ORB_FRAG = /* glsl */ `
        uniform float uTime;
        varying vec3 vNormal;
        varying vec3 vViewPos;
        varying float vNoise;
        void main(){
            vec3 n=normalize(vNormal);
            vec3 v=normalize(-vViewPos);
            vec3 L=normalize(vec3(-0.5,0.7,0.6));
            vec3 coral=vec3(1.0,0.42,0.29);
            vec3 peach=vec3(1.0,0.6,0.42);
            vec3 teal=vec3(0.18,0.77,0.71);
            vec3 deep=vec3(0.028,0.03,0.038);
            float fres=pow(1.0-max(dot(n,v),0.0),2.4);
            float diff=max(dot(n,L),0.0);
            float spec=pow(max(dot(reflect(-L,n),v),0.0),40.0);
            float bands=0.5+0.5*sin(vNoise*5.0+uTime*0.5+n.y*2.0);
            vec3 iri=mix(mix(coral,peach,smoothstep(0.0,0.5,bands)),teal,smoothstep(0.45,1.0,bands));
            float contour=smoothstep(0.92,1.0,0.5+0.5*sin(vNoise*36.0));
            vec3 col=deep;
            col+=iri*diff*0.12;
            col+=iri*fres*1.25;
            col+=iri*contour*0.22*(1.0-fres);
            col+=vec3(1.0,0.96,0.92)*spec*0.45;
            gl_FragColor=vec4(col,1.0);
        }
    `;

    const DUST_VERT = /* glsl */ `
        uniform float uTime;
        uniform float uPixelRatio;
        attribute float aSize;
        attribute float aSeed;
        varying float vSeed;
        varying float vAlpha;
        void main(){
            vec4 mv=modelViewMatrix*vec4(position,1.0);
            gl_Position=projectionMatrix*mv;
            gl_PointSize=aSize*uPixelRatio*(16.0/-mv.z);
            vSeed=aSeed;
            vAlpha=0.45+0.55*sin(uTime*1.3+aSeed*60.0);
        }
    `;

    const DUST_FRAG = /* glsl */ `
        varying float vSeed;
        varying float vAlpha;
        void main(){
            float d=length(gl_PointCoord-0.5);
            if(d>0.5) discard;
            float a=smoothstep(0.5,0.0,d);
            vec3 coral=vec3(1.0,0.42,0.29);
            vec3 teal=vec3(0.18,0.77,0.71);
            vec3 tint=mix(teal,coral,step(0.6,vSeed));
            vec3 col=mix(vec3(0.95,0.93,0.9),tint,step(0.55,vSeed)*0.85);
            gl_FragColor=vec4(col,a*vAlpha*0.85);
        }
    `;

    function fail() {
        hero?.classList.remove('gl-ready');
    }

    async function init() {
        if (!hero || !canvas) return;

        let THREE;
        try {
            THREE = await import('https://cdn.jsdelivr.net/npm/three@0.170.0/build/three.module.js');
        } catch (e) {
            return fail();
        }

        let renderer;
        try {
            renderer = new THREE.WebGLRenderer({ canvas, antialias: true, alpha: true, powerPreference: 'high-performance' });
        } catch (e) {
            return fail();
        }

        const isSmall = () => window.innerWidth < 760;
        const mobile = isSmall() || window.matchMedia('(pointer: coarse)').matches;
        const dpr = Math.min(window.devicePixelRatio || 1, mobile ? 1.5 : 2);
        renderer.setPixelRatio(dpr);
        renderer.setClearColor(0x000000, 0);

        // If a shader fails to compile, keep the CSS orb instead of a blank canvas.
        let shaderBroken = false;
        renderer.debug.onShaderError = (gl, program, vs, fs) => {
            shaderBroken = true;
            console.error('[hero] shader error', gl.getProgramInfoLog(program), gl.getShaderInfoLog(vs), gl.getShaderInfoLog(fs));
            fail();
        };

        const scene = new THREE.Scene();
        const camera = new THREE.PerspectiveCamera(35, 1, 0.1, 100);
        camera.position.set(0, 0, 9);

        const world = new THREE.Group();
        scene.add(world);

        // --- Orb ---
        const orbUniforms = {
            uTime: { value: 0 },
            uAmp: { value: 0.0 },
            uFreq: { value: 0.85 },
        };
        const orb = new THREE.Mesh(
            new THREE.IcosahedronGeometry(1.55, mobile ? 40 : 72),
            new THREE.ShaderMaterial({ vertexShader: ORB_VERT, fragmentShader: ORB_FRAG, uniforms: orbUniforms })
        );
        world.add(orb);

        // --- Ring of dust + far field ---
        const ring = new THREE.Group();
        ring.rotation.set(1.22, 0.0, -0.32);
        world.add(ring);

        const COUNT = mobile ? 1100 : 3200;
        const positions = new Float32Array(COUNT * 3);
        const sizes = new Float32Array(COUNT);
        const seeds = new Float32Array(COUNT);
        for (let i = 0; i < COUNT; i++) {
            const far = Math.random() < 0.18;
            if (far) {
                // loose sphere of dust far away (in ring space, still fine visually)
                const r = 5 + Math.random() * 6;
                const th = Math.random() * Math.PI * 2;
                const ph = Math.acos(2 * Math.random() - 1);
                positions[i * 3] = r * Math.sin(ph) * Math.cos(th);
                positions[i * 3 + 1] = r * Math.sin(ph) * Math.sin(th);
                positions[i * 3 + 2] = r * Math.cos(ph);
                sizes[i] = 0.6 + Math.random() * 1.2;
            } else {
                const r = 2.25 + Math.pow(Math.random(), 1.8) * 1.9;
                const a = Math.random() * Math.PI * 2;
                const g = (Math.random() + Math.random() + Math.random() - 1.5) * 0.09 * r;
                positions[i * 3] = Math.cos(a) * r;
                positions[i * 3 + 1] = Math.sin(a) * r;
                positions[i * 3 + 2] = g;
                sizes[i] = 0.8 + Math.random() * 2.2;
            }
            seeds[i] = Math.random();
        }
        const dustGeo = new THREE.BufferGeometry();
        dustGeo.setAttribute('position', new THREE.BufferAttribute(positions, 3));
        dustGeo.setAttribute('aSize', new THREE.BufferAttribute(sizes, 1));
        dustGeo.setAttribute('aSeed', new THREE.BufferAttribute(seeds, 1));
        const dustUniforms = { uTime: { value: 0 }, uPixelRatio: { value: dpr } };
        const dust = new THREE.Points(
            dustGeo,
            new THREE.ShaderMaterial({
                vertexShader: DUST_VERT,
                fragmentShader: DUST_FRAG,
                uniforms: dustUniforms,
                transparent: true,
                depthWrite: false,
                blending: THREE.AdditiveBlending,
            })
        );
        ring.add(dust);

        // Thin orbit lines
        [2.6, 3.55].forEach((r, idx) => {
            const pts = new THREE.EllipseCurve(0, 0, r, r).getPoints(180).map((p) => new THREE.Vector3(p.x, p.y, 0));
            const line = new THREE.LineLoop(
                new THREE.BufferGeometry().setFromPoints(pts),
                new THREE.LineBasicMaterial({ color: idx ? 0x2ec4b6 : 0xf2efe9, transparent: true, opacity: idx ? 0.12 : 0.08 })
            );
            ring.add(line);
        });

        // --- Layout: orb sits right on desktop, centered-high on mobile ---
        let baseX = 0, baseY = 0, baseScale = 1;
        function resize() {
            const w = hero.clientWidth;
            const h = hero.clientHeight;
            renderer.setSize(w, h, false);
            camera.aspect = w / h;
            camera.updateProjectionMatrix();
            if (w < 760) {
                // Portrait phones: smaller orb, lifted clear of the headline
                baseX = 0.15; baseY = 1.6; baseScale = 0.6;
            } else {
                const aspect = w / h;
                baseX = Math.min(2.4, 1.0 + aspect * 0.75);
                baseY = 0.25;
                baseScale = 1;
            }
        }
        resize();
        window.addEventListener('resize', resize);

        // --- Input ---
        const pointer = { x: 0, y: 0, tx: 0, ty: 0 };
        window.addEventListener('pointermove', (e) => {
            pointer.tx = (e.clientX / window.innerWidth) * 2 - 1;
            pointer.ty = (e.clientY / window.innerHeight) * 2 - 1;
        }, { passive: true });

        const clamp = (v, a, b) => Math.min(b, Math.max(a, v));
        const easeOut = (t) => 1 - Math.pow(1 - t, 3);

        let t = 0;
        let intro = 0;
        function frame(dt) {
            t += dt;
            intro = Math.min(1, intro + dt / 2.2);
            const k = easeOut(intro);

            const scroll = clamp(window.scrollY / Math.max(1, hero.clientHeight), 0, 1.2);

            pointer.x += (pointer.tx - pointer.x) * 0.045;
            pointer.y += (pointer.ty - pointer.y) * 0.045;

            orbUniforms.uTime.value = t;
            orbUniforms.uAmp.value = (0.26 + Math.abs(pointer.x) * 0.06 + scroll * 0.18) * k;
            dustUniforms.uTime.value = t;

            const s = baseScale * (0.72 + 0.28 * k) * (1 - scroll * 0.18);
            orb.scale.setScalar(s);
            orb.rotation.y = t * 0.08;
            orb.rotation.x = t * 0.05;

            ring.scale.setScalar(baseScale * (0.85 + 0.15 * k));
            ring.rotation.z = -0.32 + t * 0.035;

            world.position.x = baseX - scroll * 0.6;
            world.position.y = baseY + scroll * 1.6;
            world.rotation.y = pointer.x * 0.32;
            world.rotation.x = pointer.y * 0.2 + scroll * 0.35;

            camera.position.z = 9 + scroll * 2.2;

            renderer.render(scene, camera);
        }

        // Static frame for reduced motion
        if (reduceMotion) {
            t = 4; intro = 1;
            frame(0);
            if (shaderBroken) return;
            hero.classList.add('gl-ready');
            window.addEventListener('resize', () => frame(0));
            return;
        }

        // Animated loop — paused when the hero is off-screen or the tab is hidden
        let visible = true;
        let raf = 0;
        let last = performance.now();
        const loop = (now) => {
            const dt = Math.min(0.05, (now - last) / 1000);
            last = now;
            frame(dt);
            raf = requestAnimationFrame(loop);
        };
        const start = () => {
            if (raf || !visible || document.hidden) return;
            last = performance.now();
            raf = requestAnimationFrame(loop);
        };
        const stop = () => { cancelAnimationFrame(raf); raf = 0; };

        new IntersectionObserver(([entry]) => {
            visible = entry.isIntersecting;
            visible ? start() : stop();
        }).observe(hero);
        document.addEventListener('visibilitychange', () => (document.hidden ? stop() : start()));

        canvas.addEventListener('webglcontextlost', (e) => { e.preventDefault(); stop(); fail(); });

        frame(0);
        if (shaderBroken) return;
        hero.classList.add('gl-ready');
        start();
    }

    init();
</script>
